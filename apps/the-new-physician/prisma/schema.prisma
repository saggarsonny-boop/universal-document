generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Introspected Models ---

model attorneys {
  id                 String   @id
  clerk_id           String   @unique
  email              String   @unique
  stripe_customer_id String?  @unique
  subscription_tier  String   @default("FREE")
  subscription_id    String?
  created_at         DateTime @default(now())
}

model documents {
  id               String    @id
  sender_id        String
  original_pdf_url String
  created_at       DateTime  @default(now())
  status           String    @default("PENDING")
  expires_at       DateTime
  pdf_base64       String
  signers          signers[]
}

model signature_events {
  id            String   @id
  signer_id     String
  event_type    String
  timestamp     DateTime @default(now())
  hash_before   String?
  hash_after    String?
  payload_jsonb Json?
  signers       signers  @relation(fields: [signer_id], references: [id], onDelete: Cascade)
}

model signers {
  id               String             @id
  document_id      String
  order_index      Int
  name             String
  email            String
  token            String             @unique
  status           String             @default("PENDING")
  signed_at        DateTime?
  ip               String?
  fingerprint      String?
  geolocation      String?
  signed_base64    String?
  signature_events signature_events[]
  documents        documents          @relation(fields: [document_id], references: [id], onDelete: Cascade)
}

// --- The New Physician App Models ---

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  plan          String    @default("FOUNDER")
  accounts      Account[]
  sessions      Session[]
  scripts       Script[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Script {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  audioUrl    String
  duration    Int      // Duration in seconds
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// --- HiveIMR Global Pilot Registrations ---

model IMRPilotRegistration {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  practiceType          String   // "SOLO", "CLINIC", "SYSTEM"
  stateCountry          String
  meansTested           Boolean  @default(false)
  systemicCaptureScore  Int
  answers               String   @db.Text // JSON string of user answers
  createdAt             DateTime @default(now())
}
